# ==============================================================================
# OKX AlphaPilot - 环境与交易配置 (.env)
# 复制本文件重命名为 .env，并与 AlphaPilot.exe 放置在同一目录下
# ==============================================================================

# 交易模式：paper (模拟盘) 或 live (实盘)
TRADING_MODE=live

# OKX API 凭证 (实盘必需，请在 OKX 官网 API 管理页面申请并开启交易权限)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_API_BASE=https://www.okx.com
OKX_SIMULATED=0

# 默认风控与杠杆设置
MAX_POSITION_PCT=0.80
DEFAULT_LEVERAGE=5

# 阶梯主动止盈 (1=开启, 0=关闭)
ENABLE_LADDER_TP=1
LADDER_TP_TIER1_PCT=0.025
LADDER_TP_TIER1_CAP=0.65
LADDER_TP_TIER2_PCT=0.045
LADDER_TP_TIER2_CAP=0.30

# Web 服务配置 (桌面端会自动管理)
WEB_HOST=127.0.0.1
WEB_PORT=8009
