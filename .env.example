# OKX 环境变量模板
# 复制为 .env 并填写

# ── 交易模式 ──────────────────────────────────
# paper = 模拟盘（默认），live = 实盘
TRADING_MODE=paper

# ── OKX API 凭证（实盘需要）────────────────────
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_API_BASE=https://www.okx.com
# 1=模拟盘, 0=实盘
OKX_SIMULATED=1

# ── Web 服务 ──────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=8009
